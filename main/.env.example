# Dwipa main/ frontend environment contract
#
# The current frontend is mostly static, but these variables are the intended
# contract once main/ starts reading its data and auth state from ai/.

# Public site URL for main/
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of ai/ backend
NEXT_PUBLIC_AI_BASE_URL=http://localhost:4000

# Website-facing API root served by ai/
NEXT_PUBLIC_WEB_API_BASE_URL=http://localhost:4000/api/web/v1
