generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String                 @id @map("id")
  name              String                 @map("name")
  email             String                 @unique @map("email")
  emailVerified     Boolean                @default(false) @map("emailVerified")
  image             String?                @map("image")
  createdAt         DateTime               @default(now()) @map("createdAt")
  updatedAt         DateTime               @map("updatedAt")
  accounts          Account[]
  adminState        AdminUserState?
  apiKeys           ApiKey[]
  AuthChallenge     AuthChallenge[]
  BillingInvoice    BillingInvoice[]
  payments          BillingManualPayment[]
  subscriptions     PlanSubscription[]
  profile           Profile?
  sessions          Session[]
  UsageCharge       UsageCharge[]
  UsageDailySummary UsageDailySummary[]
  usageRequests     UsageRequest[]

  @@map("User")
}

model AdminUserState {
  userId       String    @id @map("userId")
  isBanned     Boolean   @default(false) @map("isBanned")
  banReason    String?   @map("banReason")
  bannedAt     DateTime? @map("bannedAt") @db.Timestamp(6)
  deletedAt    DateTime? @map("deletedAt") @db.Timestamp(6)
  deleteReason String?   @map("deleteReason")
  updatedAt    DateTime  @default(now()) @map("updatedAt") @db.Timestamp(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("AdminUserState")
}

model Session {
  id        String   @id @map("id")
  expiresAt DateTime @map("expiresAt")
  token     String   @unique @map("token")
  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @map("updatedAt")
  ipAddress String?  @map("ipAddress")
  userAgent String?  @map("userAgent")
  userId    String   @map("userId")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("Session")
}

model Account {
  id                    String    @id @map("id")
  accountId             String    @map("accountId")
  providerId            String    @map("providerId")
  userId                String    @map("userId")
  accessToken           String?   @map("accessToken")
  refreshToken          String?   @map("refreshToken")
  accessTokenExpiresAt  DateTime? @map("accessTokenExpiresAt")
  refreshTokenExpiresAt DateTime? @map("refreshTokenExpiresAt")
  scope                 String?   @map("scope")
  idToken               String?   @map("idToken")
  password              String?   @map("password")
  createdAt             DateTime  @default(now()) @map("createdAt")
  updatedAt             DateTime  @map("updatedAt")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("Account")
}

model Profile {
  userId    String   @id @map("userId")
  username  String?  @map("username")
  avatarUrl String?  @map("avatarUrl")
  company   String?  @map("company")
  timezone  String?  @map("timezone")
  bio       String?  @map("bio")
  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @map("updatedAt")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Profile")
}

model DeletedUserEmail {
  normalizedEmail String   @id @map("normalizedEmail")
  originalEmail   String   @map("originalEmail")
  deletedUserId   String   @map("deletedUserId")
  reason          String?  @map("reason")
  deletedAt       DateTime @default(now()) @map("deletedAt") @db.Timestamp(6)

  @@index([deletedAt(sort: Desc), deletedUserId], map: "DeletedUserEmail_deletedAt_idx")
  @@map("DeletedUserEmail")
}

model AdminAuditEvent {
  id              String   @id @map("id")
  actorAdminEmail String   @map("actorAdminEmail")
  action          String   @map("action")
  targetType      String   @map("targetType")
  targetId        String   @map("targetId")
  summary         String   @map("summary")
  metadataJson    String?  @map("metadataJson")
  createdAt       DateTime @default(now()) @map("createdAt") @db.Timestamp(6)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("AdminAuditEvent")
}

model BillingManualDestination {
  id                String                 @id @map("id")
  provider          String                 @map("provider")
  displayName       String                 @map("displayName")
  accountNumber     String                 @map("accountNumber")
  accountHolderName String?                @map("accountHolderName")
  instructions      String?                @map("instructions")
  isActive          Boolean                @default(true) @map("isActive")
  updatedAt         DateTime               @map("updatedAt")
  createdAt         DateTime               @default(now())
  payments          BillingManualPayment[]

  @@map("BillingManualDestination")
}

model BillingManualPayment {
  id                   String                     @id @map("id")
  userId               String                     @map("userId")
  destinationId        String                     @map("destinationId")
  purpose              String                     @map("purpose")
  status               BillingManualPaymentStatus @default(pending_transfer) @map("status")
  planSlug             String?                    @map("planSlug")
  amountMinor          Int                        @map("amountMinor")
  currency             String                     @map("currency")
  referenceCode        String                     @unique @map("referenceCode")
  senderName           String?                    @map("senderName")
  senderReference      String?                    @map("senderReference")
  transferredAt        DateTime?                  @map("transferredAt")
  submittedAt          DateTime?                  @map("submittedAt")
  notes                String?                    @map("notes")
  expiresAt            DateTime?                  @map("expiresAt")
  createdAt            DateTime                   @default(now()) @map("createdAt")
  updatedAt            DateTime                   @map("updatedAt")
  approvedAt           DateTime?                  @map("approvedAt") @db.Timestamp(6)
  approvedByAdminEmail String?                    @map("approvedByAdminEmail")
  rejectedAt           DateTime?                  @map("rejectedAt") @db.Timestamp(6)
  rejectedByAdminEmail String?                    @map("rejectedByAdminEmail")
  rejectionReason      String?                    @map("rejectionReason")
  BillingInvoice       BillingInvoice?
  destination          BillingManualDestination   @relation(fields: [destinationId], references: [id])
  user                 User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt(sort: Desc)], map: "BillingManualPayment_status_idx")
  @@index([userId, status])
  @@map("BillingManualPayment")
}

model ModelCatalog {
  id                  String         @id @map("id")
  slug                String         @unique @map("slug")
  name                String         @map("name")
  provider            String         @map("provider")
  providerCode        String         @map("providerCode")
  modelId             String         @unique @map("modelId")
  category            String         @map("category")
  summary             String         @map("summary")
  contextWindow       Int?           @map("contextWindow")
  inputPriceUsdPer1M  Decimal        @map("inputPriceUsdPer1M") @db.Decimal(18, 6)
  outputPriceUsdPer1M Decimal        @map("outputPriceUsdPer1M") @db.Decimal(18, 6)
  latencyMs           Int?           @map("latencyMs")
  isActive            Boolean        @default(true) @map("isActive")
  sortOrder           Int            @default(0) @map("sortOrder")
  createdAt           DateTime       @default(now()) @map("createdAt")
  updatedAt           DateTime       @map("updatedAt")
  UsageRequest        UsageRequest[]

  @@index([sortOrder, name])
  @@map("ModelCatalog")
}

model ApiKey {
  id           String          @id @map("id")
  userId       String          @map("userId")
  label        String          @map("label")
  keyPrefix    String
  hashedSecret String
  maskedKey    String          @map("maskedKey")
  status       ApiKeyStatus    @default(active) @map("status")
  lastUsedAt   DateTime?       @map("lastUsedAt")
  createdAt    DateTime        @default(now()) @map("createdAt")
  updatedAt    DateTime        @map("updatedAt")
  usageMode    ApiKeyUsageMode @default(both) @map("usageMode")
  name         String          @default("") @map("name")
  key          String?         @map("key")
  keyHash      String?         @map("keyHash")
  machineId    String?         @map("machineId")
  isActive     Boolean         @default(true) @map("isActive")
  revokedAt    DateTime?       @map("revokedAt") @db.Timestamp(6)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  UsageRequest UsageRequest[]

  @@index([key])
  @@index([machineId])
  @@index([userId])
  @@index([userId, status])
  @@map("ApiKey")
}

model PlanCatalog {
  id                String             @id @map("id")
  slug              String             @unique @map("slug")
  name              String             @map("name")
  billingType       String             @map("billingType")
  includedCreditUsd Decimal            @map("includedCreditUsd") @db.Decimal(18, 6)
  windowHours       Int?               @map("windowHours")
  discountPercent   Decimal            @map("discountPercent") @db.Decimal(8, 4)
  priceCurrency     String             @map("priceCurrency")
  priceMinor        Int                @map("priceMinor")
  periodLabel       String             @map("periodLabel")
  description       String             @map("description")
  ctaLabel          String             @map("ctaLabel")
  highlighted       Boolean            @default(false) @map("highlighted")
  isActive          Boolean            @default(true) @map("isActive")
  sortOrder         Int                @default(0)
  createdAt         DateTime           @default(now()) @map("createdAt")
  updatedAt         DateTime           @map("updatedAt")
  entitlements      PlanEntitlement[]
  subscriptions     PlanSubscription[]

  @@map("PlanCatalog")
}

model PlanSubscription {
  id        String             @id @map("id")
  userId    String             @map("userId")
  planId    String             @map("planId")
  status    SubscriptionStatus @default(active) @map("status")
  autoRenew Boolean            @default(true) @map("autoRenew")
  startsAt  DateTime           @map("startsAt")
  renewsAt  DateTime?          @map("renewsAt")
  endsAt    DateTime?          @map("endsAt")
  createdAt DateTime           @default(now()) @map("createdAt")
  updatedAt DateTime           @map("updatedAt")
  plan      PlanCatalog        @relation(fields: [planId], references: [id])
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  windows   QuotaWindow?

  @@index([userId, status])
  @@map("PlanSubscription")
}

model PlanEntitlement {
  id        String      @id @default(uuid()) @map("id")
  planId    String      @map("planId")
  label     String      @map("label")
  value     String      @map("value")
  sortOrder Int         @default(0) @map("sortOrder")
  createdAt DateTime    @default(now()) @map("createdAt")
  updatedAt DateTime
  plan      PlanCatalog @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, sortOrder])
  @@map("PlanEntitlement")
}

model QuotaWindow {
  id                 String            @id @map("id")
  subscriptionId     String            @unique(map: "QuotaWindow_subscription_active_uniq", where: raw("(status = 'active'::\"QuotaWindowStatus\")")) @map("subscriptionId")
  planSlug           String            @map("planSlug")
  windowStart        DateTime          @map("windowStart")
  windowEnd          DateTime          @map("windowEnd")
  includedCreditUsd  Decimal           @map("includedCreditUsd") @db.Decimal(18, 6)
  consumedCreditUsd  Decimal           @map("consumedCreditUsd") @db.Decimal(18, 6)
  remainingCreditUsd Decimal           @map("remainingCreditUsd") @db.Decimal(18, 6)
  status             QuotaWindowStatus @default(active) @map("status")
  createdAt          DateTime          @default(now()) @map("createdAt")
  updatedAt          DateTime          @map("updatedAt")
  subscription       PlanSubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  UsageCharge        UsageCharge[]

  @@index([subscriptionId, status])
  @@map("QuotaWindow")
}

model UsageRequest {
  id             String             @id @map("id")
  userId         String             @map("userId")
  apiKeyId       String?
  modelCatalogId String?
  provider       String             @map("provider")
  model          String             @map("model")
  status         UsageRequestStatus @default(pending) @map("status")
  inputTokens    Int                @default(0) @map("inputTokens")
  outputTokens   Int                @default(0) @map("outputTokens")
  latencyMs      Int?               @map("latencyMs")
  createdAt      DateTime           @default(now()) @map("createdAt")
  updatedAt      DateTime
  charge         UsageCharge?
  ApiKey         ApiKey?            @relation(fields: [apiKeyId], references: [id])
  ModelCatalog   ModelCatalog?      @relation(fields: [modelCatalogId], references: [id])
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("UsageRequest")
}

model UsageCharge {
  id                    String       @id @map("id")
  userId                String
  usageRequestId        String       @unique @map("usageRequestId")
  quotaWindowId         String?
  planSlug              String       @map("planSlug")
  baseCostUsd           Decimal      @db.Decimal(18, 6)
  discountUsd           Decimal      @db.Decimal(18, 6)
  chargedCostUsd        Decimal      @map("chargedCostUsd") @db.Decimal(18, 6)
  countedTowardQuotaUsd Decimal      @map("countedTowardQuotaUsd") @db.Decimal(18, 6)
  createdAt             DateTime     @default(now()) @map("createdAt")
  updatedAt             DateTime
  QuotaWindow           QuotaWindow? @relation(fields: [quotaWindowId], references: [id])
  usageRequest          UsageRequest @relation(fields: [usageRequestId], references: [id], onDelete: Cascade)
  User                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("UsageCharge")
}

model AuthChallenge {
  id            String              @id
  userId        String?
  email         String
  type          AuthChallengeType
  status        AuthChallengeStatus @default(pending)
  betterAuthRef String?
  expiresAt     DateTime
  verifiedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime
  User          User?               @relation(fields: [userId], references: [id])

  @@index([email, status])
  @@index([userId])
}

model BillingInvoice {
  id                   String                @id
  userId               String
  manualPaymentId      String?               @unique
  number               String                @unique
  status               BillingInvoiceStatus  @default(draft)
  amountMinor          Int
  currency             String
  issuedAt             DateTime?
  dueAt                DateTime?
  paidAt               DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime
  BillingManualPayment BillingManualPayment? @relation(fields: [manualPaymentId], references: [id])
  User                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  BillingInvoiceLine   BillingInvoiceLine[]

  @@index([userId, status])
}

model BillingInvoiceLine {
  id             String         @id
  invoiceId      String
  label          String
  amountMinor    Int
  currency       String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  BillingInvoice BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model UsageDailySummary {
  id                String   @id
  userId            String
  day               DateTime @db.Date
  requestCount      Int      @default(0)
  totalCostUsd      Decimal  @db.Decimal(18, 6)
  totalInputTokens  Int      @default(0)
  totalOutputTokens Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime
  User              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime?

  @@index([identifier])
}

enum ApiKeyStatus {
  active
  revoked
}

enum ApiKeyUsageMode {
  subscription
  payg
  both
}

enum AuthChallengeStatus {
  pending
  verified
  expired
  canceled
}

enum AuthChallengeType {
  sign_up
  password_reset
}

enum BillingInvoiceStatus {
  draft
  issued
  paid
  void
}

enum BillingManualPaymentStatus {
  pending_transfer
  submitted
  under_review
  approved
  rejected
  expired
}

enum QuotaWindowStatus {
  active
  exhausted
  expired
}

enum SubscriptionStatus {
  active
  canceled
  pending_payment
  expired
}

enum UsageRequestStatus {
  pending
  success
  failed
  rejected
}
